/* Global styles */
QWidget {
    background-color: #F3F4F6;
    color: #1F2937;
    font-family: 'Inter', 'Geist', 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, Arial, sans-serif;
    font-size: 12px;
}

/* Headers and Titles */
QLabel#MainTitle {
    font-size: 16px;
    font-weight: 700;
    color: #111827;
    line-height: 1.2;
}

QLabel#SubTitle {
    font-size: 12px;
    font-weight: 400;
    color: #6B7280;
}

QLabel#SectionTitle {
    font-size: 15px;
    font-weight: 650;
    color: #111827;
}

/* Cards / Panels */
.Card {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
}

/* Comboboxes */
QComboBox {
    background-color: #FFFFFF;
    border: 1px solid #D1D5DB;
    border-radius: 6px;
    padding: 4px 10px;
    height: 30px;
    color: #1F2937;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left-width: 0px;
}

/* Buttons */
QPushButton {
    background-color: #FFFFFF;
    border: 1px solid #D1D5DB;
    border-radius: 6px;
    padding: 5px 14px;
    height: 30px;
    font-weight: 500;
    color: #1F2937;
}

QPushButton:hover {
    background-color: #F9FAFB;
}

QPushButton#PrimaryActionButton {
    background-color: #0F766E;
    color: #FFFFFF;
    border: 1px solid #0F766E;
}

QPushButton#PrimaryActionButton:hover {
    background-color: #115E59;
}

/* Video Cards (wrapper around each video panel) */
.VideoCard {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 10px;
}

QFrame#CompressedVideoCard {
    border-top: 3px solid #EF4444;
}

QFrame#EnhancedVideoCard {
    border-top: 3px solid #0F766E;
}

QLabel#VideoPanelTitle {
    font-size: 14px;
    font-weight: 700;
    color: #111827;
    background: transparent;
}

/* Video Canvases */
QWidget#CompressedCanvas {
    background-color: #0f0f1a;
    border: none;
    border-radius: 6px;
}

QWidget#EnhancedCanvas {
    background-color: #0f0f1a;
    border: none;
    border-radius: 6px;
}

QLabel#CompressedBadge {
    color: #EF4444;
    background-color: #FEF2F2;
    border: 1px solid #FEE2E2;
    border-radius: 14px;
    padding: 4px 10px;
    font-weight: 600;
    font-size: 11px;
}

QLabel#EnhancedBadge {
    color: #0F766E;
    background-color: #F0FDFA;
    border: 1px solid #CCFBF1;
    border-radius: 14px;
    padding: 4px 10px;
    font-weight: 600;
    font-size: 11px;
}

/* Playback Control */
QWidget#PlaybackBar {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
}

QPushButton#PlayButton {
    background: transparent;
    border: none;
    font-size: 15px;
    color: #374151;
    padding: 0;
    min-width: 30px;
    height: 30px;
}
QPushButton#PlayButton:hover {
    color: #0F766E;
}

QLabel#FrameBox {
    background: #FFFFFF;
    border: 1px solid #D1D5DB;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 13px;
}

QLabel#FrameTotal {
    color: #6B7280;
    font-size: 13px;
}

QSlider::groove:horizontal {
    border: none;
    height: 4px;
    background: #E5E7EB;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: #0F766E;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #0F766E;
    width: 14px;
    margin: -5px 0;
    border-radius: 7px;
}

QCheckBox {
    spacing: 6px;
    color: #374151;
    font-size: 13px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #D1D5DB;
    border-radius: 4px;
    background: #FFFFFF;
}

QCheckBox::indicator:checked {
    background: #0F766E;
    border-color: #0F766E;
}

/* Tables */
QTableWidget {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
    gridline-color: #E5E7EB;
    font-size: 12px;
}

QHeaderView::section {
    background-color: #F9FAFB;
    border: none;
    border-bottom: 1px solid #E5E7EB;
    padding: 10px 12px;
    font-weight: 650;
    color: #374151;
    text-align: left;
}

QTableWidget::item {
    padding: 8px 12px;
    border-bottom: 1px solid #F3F4F6;
    color: #1F2937;
}

QTableWidget::item:selected {
    background-color: #F0FDFA;
    color: #1F2937;
}

/* Metric text */
.MetricValue {
    font-size: 15px;
    font-weight: 700;
    color: #111827;
}

.MetricDeltaPositive {
    color: #0F766E;
    font-weight: 600;
    font-size: 10px;
}

.MetricDeltaNegative {
    color: #EF4444;
    font-weight: 600;
    font-size: 10px;
}

.MetricNeutral {
    color: #6B7280;
    font-size: 10px;
}

/* Badges */
.BadgeImproved {
    color: #0F766E;
    background-color: #F0FDFA;
    border: 1px solid #CCFBF1;
    border-radius: 12px;
    padding: 4px 8px;
    font-weight: 600;
    font-size: 11px;
}

.BadgeNeutral {
    color: #4B5563;
    background-color: #F3F4F6;
    border: 1px solid #E5E7EB;
    border-radius: 12px;
    padding: 4px 8px;
    font-weight: 600;
    font-size: 11px;
}

.BadgeFailure {
    color: #EF4444;
    background-color: #FEF2F2;
    border: 1px solid #FEE2E2;
    border-radius: 12px;
    padding: 4px 8px;
    font-weight: 600;
    font-size: 11px;
}

/* ScrollArea */
QScrollArea {
    border: none;
    background: #F3F4F6;
}

QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 8px;
    margin: 0px 0px 0px 0px;
}

QScrollBar::handle:vertical {
    background: #D1D5DB;
    min-height: 20px;
    border-radius: 4px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
